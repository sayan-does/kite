SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=
GROQ_API_KEY=
YOUTUBE_API_KEY=
EMAIL_API_KEY=
EMAIL_FROM=Kite <onboarding@resend.dev>
SEARX_URL=
# Comma-separated browser origins. Include the production frontend URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# In-process APScheduler. Set false on hosts that sleep; call POST /internal/run-daily instead.
ENABLE_SCHEDULER=true
PREFILL_ON_STARTUP=true
GROQ_MODEL=openai/gpt-oss-120b
DISCOVERY_V2=false
KB_FEED=false
KB_STACK_MIN_USERS=3
KB_RETENTION_DAYS=14

# --- Phase 10: dynamic feed pipeline ---
FEED_V3=false
# Primary summarization provider. 1500 RPD / 1M TPM on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Optional spillover. 50 req/day free, 1000 after a one-time $10 credit purchase.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GROQ_SMALL_MODEL=openai/gpt-oss-20b
# Shared secret the Supabase cron job sends as X-Internal-Secret.
INTERNAL_TRIGGER_SECRET=
LLM_MAX_REQUESTS_PER_CYCLE=60
LLM_MAX_TOKENS_PER_CYCLE=120000
COLLECT_MAX_CONCURRENCY=8
FEED_HALF_LIFE_HOURS=48
FEED_STACK_HALF_LIFE_HOURS=336

# Daily AI quiz (off by default)
QUIZ_ENABLED=false
